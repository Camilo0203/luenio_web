# Copy to /etc/luenio/edge.env on the VPS and set mode 600.
# Cloudflare Access remains the primary editor gate; these credentials are defense in depth.

TRUSTED_PROXY_SECRET_PRODUCTION=CHANGE_ME_UNIQUE_OPENSSL_RAND_HEX_32
TRUSTED_PROXY_SECRET_STAGING=CHANGE_ME_UNIQUE_OPENSSL_RAND_HEX_32

N8N_BASIC_AUTH_USER_PRODUCTION=luenio-ops
N8N_BASIC_AUTH_HASH_PRODUCTION=CHANGE_ME_CADDY_PASSWORD_HASH
N8N_BASIC_AUTH_USER_STAGING=luenio-staging-ops
N8N_BASIC_AUTH_HASH_STAGING=CHANGE_ME_DIFFERENT_CADDY_PASSWORD_HASH
