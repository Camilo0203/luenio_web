    {
      "id": "cd1891c6-eb46-496b-be9a-5ff9e63c5508",
      "name": "02 Normalizar error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const direct = $input.first()?.json || {};\nconst execution = direct.execution || {};\nconst workflow = direct.workflow || {};\nconst err = execution.error || direct.error || {};\nconst isDirect = Boolean(direct.source || direct.severity || direct.conversation_id || direct.workflow_id);\nconst value = (v) => String(v == null ? '' : v);\nreturn [{\n  json: {\n    occurred_at: new Date().toISOString(),\n    workflow_id: value(isDirect ? direct.workflow_id : (workflow.id || execution.workflowId || '')),\n    workflow_name: value(isDirect ? direct.workflow_name : (workflow.name || '')),\n    execution_id: value(isDirect ? direct.execution_id : (execution.id || '')),\n    execution_url: value(isDirect ? direct.execution_url : (execution.url || '')),\n    status: 'error',\n    last_node: value(isDirect ? direct.last_node : (execution.lastNodeExecuted || '')),\n    error_message: value(isDirect ? direct.error_message : (err.message || err.description || 'Error sin mensaje')).slice(0, 5000),\n    mode: value(isDirect ? direct.mode : (execution.mode || '')),\n    severity: isDirect ? (value(direct.severity) || 'secondary') : 'critical',\n    source: isDirect ? (value(direct.source) || 'continuation') : 'error_trigger',\n    conversation_id: value(isDirect ? direct.conversation_id : ''),\n    handled: isDirect ? true : false,\n  }\n}];"
      },
      "onError": "stopWorkflow"
    },
