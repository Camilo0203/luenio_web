        "jsCode": "const n = (v) => Number(v || 0);\nconst b = (v) => v === true || String(v).toLowerCase() === 'true';\nconst { row_number, ...data } = $json;\nconst canonical = {\n  'package:essential': {\n    ideal_for: 'Negocios pequeños que necesitan presencia web y automatización inicial en WhatsApp',\n    version: 'v2'\n  },\n  'package:professional': {\n    ideal_for: 'Negocios en crecimiento que requieren más secciones, integraciones y automatización',\n    version: 'v2'\n  },\n  'rule:02': {\n    rule_text: 'Identifica el rubro únicamente a partir de información explícita del cliente; si no está claro, pregunta sin inferir.',\n    version: 'v2'\n  }\n};\nconst normalized = { ...data, ...(canonical[String(data.record_key || '')] || {}) };\nreturn {\n  json: {\n    ...normalized,\n    price_project: n(normalized.price_project),\n    price_monthly: n(normalized.price_monthly),\n    price_min: n(normalized.price_min),\n    price_max: n(normalized.price_max),\n    active: b(normalized.active),\n    source_row: n(normalized.source_row)\n  }\n};"
