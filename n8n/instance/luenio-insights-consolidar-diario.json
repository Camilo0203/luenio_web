      "name": "01 Normalize trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst input = ($json && $json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst partsInBogota = (value) => {\n  const parts = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'America/Bogota', year: 'numeric', month: '2-digit', day: '2-digit'\n  }).formatToParts(new Date(value));\n  const map = {};\n  for (const part of parts) map[part.type] = part.value;\n  return map.year + '-' + map.month + '-' + map.day;\n};\nconst requested = String(input.target_date || '').trim();\nconst targetDate = /^\\d{4}-\\d{2}-\\d{2}$/.test(requested)\n  ? requested\n  : partsInBogota(new Date(Date.now() - 24 * 60 * 60 * 1000));\nreturn [{json:{\n  target_date: targetDate,\n  target_environment: 'production',\n  dry_run: input.dry_run !== false,\n  started_at: new Date().toISOString()\n}}];"
      },
      "onError": "stopWorkflow"
    },
