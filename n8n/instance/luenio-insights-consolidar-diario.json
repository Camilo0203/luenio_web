    {
      "id": "7617bccd-3014-4f29-8542-1e937b110817",
      "name": "05 Aggregate daily",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst rows = $input.all().map((item) => item.json || {});\nconst cfg = $(\"01 Normalize trigger\").first().json;\nconst targetDate = String(cfg.target_date);\nconst TZ = 'America/Bogota';\nconst eventTypes = new Set([\n  'turn_processed','turn_blocked','duplicate_blocked','handoff','opt_out',\n  'reset','followup_dry_run','followup_sent','followup_failed',\n  'proposal_sent','proposal_accepted'\n]);\nconst partsInBogota = (value) => {\n  const parts = new Intl.DateTimeFormat('en-CA', {\n    timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit'\n  }).formatToParts(new Date(value));\n  const map = {};\n  for (const part of parts) map[part.type] = part.value;\n  return map.year + '-' + map.month + '-' + map.day;\n};\nconst parseTime = (value) => {\n  const time = Date.parse(String(value || ''));\n  return Number.isFinite(time) ? time : NaN;\n};\nconst productionWorkflowIds = new Set([\n  'TTF82QAR4HEPtUMx','WXd1LnLLBRXIqvj5','BDSexxBUSXWgGTCT','SoPRTYavFC58ezIG',\n  'veHhGXM1jFaHVkTz','roa83xYOinxUEhRN','JAtiEwJwK0gVfGhe','iO7jw31alKTZH9ee',\n  'ASS5sfyqGKQTPyy9','cH15aZjmkstGEM79','csLvqYKmih4zi4Fq'\n]);\nconst isProductionError = (row) => {\n  const environment = String(row.environment || '').trim().toLowerCase();\n  if (environment) return environment === 'production';\n  const workflowId = String(row.workflow_id || '').trim();\n  const workflowName = String(row.workflow_name || '').toUpperCase();\n  return productionWorkflowIds.has(workflowId) && !workflowName.includes('STAGING') && !workflowName.includes('TEST');\n};\nconst events = [];\nconst errors = [];\nfor (const row of rows) {\n  const time = parseTime(row.occurred_at);\n  if (!Number.isFinite(time) || partsInBogota(time) !== targetDate) continue;\n  if (eventTypes.has(String(row.event_type || '')) && row.event_id) {\n    if (String(row.environment || '').toLowerCase() === 'production') events.push(row);\n    continue;\n  }\n  if (row.severity && isProductionError(row)) errors.push(row);\n}\nconst bool = (value) => value === true || value === 'true' || value === 1 || value === '1';\nconst count = (predicate) => events.reduce((total, row) => total + (predicate(row) ? 1 : 0), 0);\nconst average = (values) => values.length\n  ? Math.round((values.reduce((a, b) => a + b, 0) / values.length) * 100) / 100\n  : 0;\nconst conversations = new Set(events.map((row) => String(row.conversation_id || '')).filter(Boolean));\nconst discovered = new Set(events.filter((row) => bool(row.discovery_done)).map((row) => String(row.conversation_id || '')).filter(Boolean));\nconst solutions = new Set(events.filter((row) => bool(row.solution_confirmed)).map((row) => String(row.conversation_id || '')).filter(Boolean));\nconst firstTurn = new Map();\nconst discoveryDepths = new Map();\nconst proposalTimes = new Map();\nfor (const row of events) {\n  const conversationId = String(row.conversation_id || '');\n  const time = parseTime(row.occurred_at);\n  if (!conversationId || !Number.isFinite(time)) continue;\n  if (row.event_type === 'turn_processed' && (!firstTurn.has(conversationId) || time < firstTurn.get(conversationId))) {\n    firstTurn.set(conversationId, time);\n  }\n  if (bool(row.discovery_done) && !discoveryDepths.has(conversationId)) {\n    const depth = Number(row.discovery_depth);\n    if (Number.isFinite(depth)) discoveryDepths.set(conversationId, depth);\n  }\n  if (row.event_type === 'proposal_sent' && (!proposalTimes.has(conversationId) || time < proposalTimes.get(conversationId))) {\n    proposalTimes.set(conversationId, time);\n  }\n}\nconst proposalMinutes = [];\nfor (const [conversationId, proposalTime] of proposalTimes.entries()) {\n  if (firstTurn.has(conversationId)) proposalMinutes.push((proposalTime - firstTurn.get(conversationId)) / 60000);\n}\nconst handoffSla = events.map((row) => Number(row.handoff_sla_ms)).filter((value) => Number.isFinite(value) && value > 0);\nreturn [{json:{\n  date: targetDate,\n  schema_version: '3.0',\n  environment: 'production',\n  unique_conversations: conversations.size,\n  inbound_messages: count((row) => ['turn_processed','turn_blocked','duplicate_blocked'].includes(row.event_type)),\n  processed_messages: count((row) => row.event_type === 'turn_processed'),\n  duplicate_messages: count((row) => row.event_type === 'duplicate_blocked'),\n  blocked_messages: count((row) => row.event_type === 'turn_blocked'),\n  discovery_completed: discovered.size,\n  solutions_confirmed: solutions.size,\n  price_requests: count((row) => bool(row.price_requested)),\n  proposal_requests: count((row) => bool(row.proposal_requested)),\n  proposals_sent: count((row) => row.event_type === 'proposal_sent'),\n  proposals_accepted: count((row) => row.event_type === 'proposal_accepted'),\n  handoffs: count((row) => row.event_type === 'handoff'),\n  opt_outs: count((row) => row.event_type === 'opt_out'),\n  followups_dry_run: count((row) => row.event_type === 'followup_dry_run'),\n  followups_sent: count((row) => row.event_type === 'followup_sent'),\n  followups_failed: count((row) => row.event_type === 'followup_failed'),\n  critical_errors: errors.filter((row) => String(row.severity).toLowerCase() === 'critical').length,\n  secondary_errors: errors.filter((row) => String(row.severity).toLowerCase() === 'secondary').length,\n  avg_turns_to_discovery: average([...discoveryDepths.values()]),\n  avg_minutes_to_proposal: average(proposalMinutes),\n  catalog_unavailable_count: count((row) => bool(row.price_requested) && !bool(row.catalog_ready)),\n  kb_resolved_count: count((row) => bool(row.kb_used)),\n  objection_count: count((row) => bool(row.objection_rule_used) || Boolean(row.objection_code)),\n  fallback_count: count((row) => bool(row.fallback_used)),\n  avg_handoff_sla_ms: average(handoffSla),\n  proposal_pending_approval: count((row) => row.proposal_status === 'pending_approval'),\n  proposal_partially_sent: count((row) => row.proposal_status === 'partially_sent'),\n  appointments_requested: count((row) => ['requested','availability_checked','pending_confirmation','pending_approval'].includes(row.appointment_status)),\n  appointments_confirmed: count((row) => row.appointment_status === 'confirmed'),\n  media_processed: count((row) => ['processed','succeeded'].includes(row.media_processing_status)),\n  media_failed: count((row) => row.media_processing_status === 'failed'),\n  generated_at: new Date().toISOString(),\n  source_version: 'luna-v3-professional',\n  status: events.length || errors.length ? 'complete' : 'empty',\n  dry_run: Boolean(cfg.dry_run),\n  should_persist: cfg.dry_run === false ? 'true' : 'false'\n}}];"
      },
      "onError": "stopWorkflow"
    },
