        "jsCode": "const base = $('01 Entrada | Contrato turno v3').first()?.json || {};\nconst interpretation = $input.first()?.json || {};\nlet catalog = {};\ntry { catalog = JSON.parse(String(base.catalog_json || '{}')); } catch { catalog = {}; }\nconst intent = String(interpretation.intent || '').trim();\nconst objectionCode = intent.startsWith('objection_') ? intent.replace(/^objection_/, '') : '';\nreturn [{ json: {\n  intent,\n  objection_code: objectionCode,\n  user_message: String(base.user_message || ''),\n  catalog_ready: catalog.catalog_ready === true,\n  source_version: '3.0.3',\n  environment: String(base.environment || 'staging'),\n  source_hash: String(base.source_hash || '')\n} }];"
