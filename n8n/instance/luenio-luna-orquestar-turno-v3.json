        "jsCode": "const base = $('01 Entrada | Contrato turno v3').first()?.json || {};\nconst interpretation = $('02 LUNA | Interpretar mensaje').first()?.json || {};\nconst approved = $('04 LUNA | Consultar KB y objeciones').first()?.json || {};\nconst decision = $input.first()?.json || {};\nconst updates = decision.crm_updates && typeof decision.crm_updates === 'object' ? decision.crm_updates : {};\nconst reply = String(decision.reply || '').trim().slice(0, 700);\nreturn [{ json: {\n  ...base,\n  ...updates,\n  final_reply: reply,\n  reply,\n  next_question_code: String(decision.next_question_code || ''),\n  action_request: decision.action_request || { type: 'none', payload: {} },\n  reason_code: String(decision.reason_code || ''),\n  interpretation: {\n    intent: String(interpretation.intent || ''),\n    confidence: Number(interpretation.confidence || 0),\n    extracted_fields: interpretation.extracted_fields || {},\n    ambiguous_fields: interpretation.ambiguous_fields || [],\n    reason_code: String(interpretation.reason_code || '')\n  },\n  approved_content: {\n    found: approved.found === true,\n    source: String(approved.source || ''),\n    key: String(approved.key || ''),\n    reason_code: String(approved.reason_code || '')\n  },\n  context_json: JSON.stringify(updates),\n  source_hash: String(base.source_hash || ''),\n  environment: String(base.environment || 'staging'),\n  luna_v3_orchestrated: true\n} }];"
