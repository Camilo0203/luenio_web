    {
      "id": "0a5fcca8-93f3-4b3d-9566-25de43332a68",
      "name": "01 Normalize event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst input = $json || {};\nconst environment = String(input.environment || 'production').trim().toLowerCase();\nif (!['production','staging','test'].includes(environment)) throw new Error('INSIGHTS_ENVIRONMENT_INVALID');\nconst forbidden = [\n  'body','message_text','history','email','phone','name',\n  'conversation_summary','raw_error','full_prompt','full_reply'\n];\nconst hasForbidden = (obj) => forbidden.some((key) => Object.prototype.hasOwnProperty.call(obj || {}, key));\nif (hasForbidden(input) || hasForbidden(input.snapshot)) throw new Error('INSIGHTS_PII_FIELD_REJECTED');\nconst allowedEvents = new Set([\n  'turn_processed','turn_blocked','duplicate_blocked','handoff','opt_out',\n  'reset','followup_dry_run','followup_sent','followup_failed',\n  'proposal_sent','proposal_accepted'\n]);\nconst eventType = String(input.event_type || '').trim();\nif (!allowedEvents.has(eventType)) throw new Error('INSIGHTS_EVENT_TYPE_INVALID');\nconst conversationId = String(input.conversation_id || '').trim();\nif (!conversationId) throw new Error('INSIGHTS_CONVERSATION_ID_REQUIRED');\nconst occurredAt = String(input.occurred_at || new Date().toISOString());\nconst minuteBucket = String(input.minute_bucket || occurredAt.slice(0, 16));\nconst bodyHash = String(input.body_hash || 'missing');\nconst messageId = String(input.message_id || '').trim();\nconst eventId = String(input.event_id || (\n  conversationId + '|' + (messageId || ('fallback:' + bodyHash + ':' + minuteBucket)) + '|' + eventType\n)).trim();\nif (!eventId) throw new Error('INSIGHTS_EVENT_ID_REQUIRED');\nconst snap = input.snapshot && typeof input.snapshot === 'object' ? input.snapshot : {};\nconst bool = (value) => value === true || value === 'true' || value === 1 || value === '1';\nconst num = (value) => {\n  const n = Number(value);\n  return Number.isFinite(n) ? n : 0;\n};\nreturn [{ json: {\n  event_id: eventId,\n  schema_version: '3.0',\n  occurred_at: occurredAt,\n  event_type: eventType,\n  conversation_id: conversationId,\n  message_id: messageId,\n  workflow_id: String(input.workflow_id || ''),\n  execution_id: String(input.execution_id || ''),\n  pipeline_stage: String(snap.pipeline_stage || ''),\n  next_action: String(snap.next_action || ''),\n  interested_service: String(snap.interested_service || ''),\n  selected_solution: String(snap.selected_solution || ''),\n  discovery_depth: num(snap.discovery_depth),\n  discovery_done: bool(snap.discovery_done),\n  solution_confirmed: bool(snap.solution_confirmed),\n  price_requested: bool(snap.price_requested),\n  proposal_requested: bool(snap.proposal_requested),\n  proposal_sent: bool(snap.proposal_sent),\n  proposal_accepted: bool(snap.proposal_accepted),\n  human_required: bool(snap.human_required),\n  bot_muted: bool(snap.bot_muted),\n  opt_out: bool(snap.opt_out),\n  duplicate_blocked: bool(snap.duplicate_blocked),\n  reply_status: String(input.reply_status || ''),\n  catalog_ready: bool(snap.catalog_ready),\n  lead_score: num(snap.lead_score),\n  reply_hash: String(input.reply_hash || ''),\n  duration_ms: num(input.duration_ms),\n  reason_code: String(input.reason_code || ''),\n  source_version: String(input.source_version || ''),\n  recommended_solution: String(snap.recommended_solution || ''),\n  objection_code: String(snap.objection_code || ''),\n  fallback_used: bool(snap.fallback_used),\n  handoff_reason: String(snap.handoff_reason || ''),\n  time_to_solution_ms: num(snap.time_to_solution_ms),\n  time_to_proposal_ms: num(snap.time_to_proposal_ms),\n  time_to_handoff_ms: num(snap.time_to_handoff_ms),\n  environment,\n  kb_used: bool(snap.kb_used),\n  kb_entry_key: String(snap.kb_entry_key || ''),\n  objection_rule_used: bool(snap.objection_rule_used),\n  handoff_sla_ms: num(snap.handoff_sla_ms),\n  proposal_status: String(snap.proposal_status || snap.proposal_delivery_status || 'none'),\n  appointment_status: String(snap.appointment_status || ''),\n  media_type: String(snap.media_type || ''),\n  media_processing_status: String(snap.media_processing_status || ''),\n  action_type: String(input.action_type || snap.action_type || 'none'),\n  approval_required: bool(input.approval_required ?? snap.approval_required),\n} }];\n"
      },
      "onError": "stopWorkflow",
      "retryOnFail": false
    },
