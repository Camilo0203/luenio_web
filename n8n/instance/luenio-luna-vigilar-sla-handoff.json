    {
      "id": "sla-filter",
      "name": "03 SLA | Seleccionar vencidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now=Date.now(); return $input.all().filter(item=>{const j=item.json||{}; const due=Date.parse(String(j.business_due_at||'')); return String(j.status||'')==='pending'&&j.alert_sent!==true&&Number.isFinite(due)&&due<=now;}).map(item=>({json:item.json}));"
      }
    },
    {
