      "id": "2b1c3d4e-5f60-4789-ab1c-2d3e4f5a6b7c",
      "name": "02 Sistema | Validar y preparar acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "function text(value) { return String(value == null ? '' : value).replace(/\\s+/g, ' ').trim(); }\nfunction bool(value) { return value === true || value === 1 || /^(true|1|yes|si)$/i.test(text(value)); }\nfunction parseObject(value) {\n  if (value && typeof value === 'object' && !Array.isArray(value)) return { ...value };\n  try {\n    const parsed = JSON.parse(text(value) || '{}');\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n  } catch { return {}; }\n}\nfunction stableHash(value) {\n  const input = text(value);\n  let h1 = 0xdeadbeef ^ input.length;\n  let h2 = 0x41c6ce57 ^ input.length;\n  for (let i = 0; i < input.length; i += 1) {\n    const code = input.charCodeAt(i);\n    h1 = Math.imul(h1 ^ code, 2654435761);\n    h2 = Math.imul(h2 ^ code, 1597334677);\n  }\n  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);\n  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);\n  return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16).padStart(14, '0');\n}\nfunction validEmail(value) { return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(text(value)); }\nfunction safePackages(catalog) {\n  const source = parseObject(catalog.catalog_packages);\n  const result = {};\n  for (const sku of ['PKG-ESSENTIAL','PKG-PROFESSIONAL']) {\n    const row = parseObject(source[sku]);\n    result[sku] = {\n      name: text(row.name),\n      price_project: Number(row.price_project || 0),\n      price_monthly: Number(row.price_monthly || 0)\n    };\n  }\n  return result;\n}\nfunction businessDueAt(nowIso) {\n  const now = new Date(nowIso);\n  const shifted = new Date(now.getTime() - 5 * 60 * 60 * 1000);\n  let y = shifted.getUTCFullYear();\n  let m = shifted.getUTCMonth();\n  let d = shifted.getUTCDate();\n  let hour = shifted.getUTCHours();\n  let minute = shifted.getUTCMinutes();\n  const day = shifted.getUTCDay();\n  const nextBusinessStart = () => {\n    do {\n      const candidate = new Date(Date.UTC(y, m, d + 1, 8, 15, 0));\n      y = candidate.getUTCFullYear(); m = candidate.getUTCMonth(); d = candidate.getUTCDate();\n    } while ([0,6].includes(new Date(Date.UTC(y,m,d)).getUTCDay()));\n    hour = 8; minute = 15;\n  };\n  if ([0,6].includes(day) || hour < 8 || hour >= 18) {\n    if (![0,6].includes(day) && hour < 8) { hour = 8; minute = 15; }\n    else nextBusinessStart();\n  } else {\n    minute += 15;\n    if (minute >= 60) { hour += Math.floor(minute / 60); minute %= 60; }\n    if (hour >= 18) nextBusinessStart();\n  }\n  return new Date(Date.UTC(y,m,d,hour + 5,minute,0)).toISOString();\n}\n\nconst input = $input.first()?.json || {};\nconst action = parseObject(input.action_request_json);\nconst context = parseObject(input.context_json);\nconst catalog = parseObject(input.catalog_json);\nconst environment = ['production','staging','test'].includes(text(input.environment)) ? text(input.environment) : 'staging';\nconst actionType = text(action.type || 'none');\nconst now = text(input.occurred_at) || new Date().toISOString();\nconst conversationId = text(input.conversation_id || context.conversation_id);\nconst minuteBucket = now.slice(0,16);\nconst messageId = text(input.message_id) || `fallback:${stableHash(JSON.stringify(context))}:${minuteBucket}`;\nconst baseKey = `${conversationId}|${messageId}`;\nconst sourceVersion = '3.0.3';\n\nif (!conversationId) throw new Error('ACTION_CONVERSATION_ID_REQUIRED');\n\nif (actionType === 'proposal') {\n  const errors = [];\n  if (!bool(context.discovery_done)) errors.push('discovery_incomplete');\n  if (!bool(context.solution_confirmed)) errors.push('solution_unconfirmed');\n  if (!bool(context.proposal_requested)) errors.push('proposal_not_requested');\n  if (!validEmail(context.email)) errors.push('email_invalid');\n  const packages = safePackages(catalog);\n  const catalogReady = catalog.catalog_ready === true &&\n    Number(packages['PKG-ESSENTIAL'].price_project || 0) > 0 &&\n    Number(packages['PKG-PROFESSIONAL'].price_project || 0) > 0;\n  if (!catalogReady) errors.push('catalog_unavailable');\n  if (errors.length) throw new Error(`PROPOSAL_ACTION_BLOCKED:${errors.join(',')}`);\n  const snapshot = {\n    schema_version:'3.0',\n    context:{\n      business_type:text(context.business_type),\n      project_goal:text(context.project_goal),\n      pain_point:text(context.pain_point),\n      current_process:text(context.current_process),\n      impact:text(context.impact),\n      desired_outcome:text(context.desired_outcome),\n      discovery_urgency:text(context.discovery_urgency),\n      recommended_solution:text(context.recommended_solution),\n      selected_solution:text(context.selected_solution),\n      solution_confirmed:bool(context.solution_confirmed),\n      conversation_summary:text(context.conversation_summary).slice(0,420)\n    },\n    catalog:{\n      version:text(catalog.catalog_version || catalog.version),\n      packages\n    }\n  };\n  const snapshotJson = JSON.stringify(snapshot);\n  const requestKey = `${baseKey}|proposal`;\n  const expires = new Date(Date.parse(now) + 15 * 24 * 60 * 60 * 1000).toISOString();\n  return [{json:{\n    ok:true,route:'proposal',request_type:'proposal',\n    request_id:`prop_${stableHash(requestKey)}`,\n    proposal_id:`prop_${stableHash(requestKey)}`,\n    request_key:requestKey,conversation_id:conversationId,message_id:messageId,\n    status:'requested',snapshot_json:snapshotJson,snapshot_hash:stableHash(snapshotJson),\n    recipient_email_hash:stableHash(text(context.email).toLowerCase()),\n    catalog_version:text(catalog.catalog_version || catalog.version),\n    proposal_version:1,requested_at:now,updated_at:now,expires_at:expires,\n    approved_at:null,approved_by:'',rejected_at:null,rejection_reason_code:'',\n    whatsapp_status:'pending',gmail_status:'pending',\n    whatsapp_delivery_id:'',gmail_delivery_id:'',last_error_code:'',\n    environment,source_version:sourceVersion,source_hash:text(input.source_hash)\n  }}];\n}\n\nif (actionType === 'handoff') {\n  const requestKey = `${baseKey}|handoff`;\n  return [{json:{\n    ok:true,route:'handoff',request_type:'handoff',\n    request_id:`hand_${stableHash(requestKey)}`,\n    handoff_id:`hand_${stableHash(requestKey)}`,\n    request_key:requestKey,conversation_id:conversationId,message_id:messageId,\n    status:'pending',handoff_reason:text(action.payload?.reason || context.handoff_reason || 'explicit_request'),\n    objection_code:text(context.objection_code),urgency:text(context.discovery_urgency || context.urgency),\n    requested_at:now,business_due_at:businessDueAt(now),\n    assigned_at:null,human_replied_at:null,acknowledged_at:null,\n    alert_sent:false,alert_sent_at:null,label_applied:false,last_error_code:'',\n    environment,source_version:sourceVersion,source_hash:text(input.source_hash)\n  }}];\n}\n\nif (actionType === 'appointment') {\n  return [{json:{\n    ok:true,route:'noop',request_type:'appointment',request_id:'',\n    status:'awaiting_customer_input',reason_code:'APPOINTMENT_REQUIRES_CONFIRMED_SLOT_AND_CONSENT',\n    environment,source_version:sourceVersion,source_hash:text(input.source_hash)\n  }}];\n}\n\nreturn [{json:{\n  ok:true,route:'noop',request_type:actionType || 'none',request_id:'',\n  status:'noop',reason_code:actionType === 'media_fallback' ? 'MEDIA_FALLBACK_NO_EXTERNAL_ACTION' : 'NO_ACTION_REQUIRED',\n  environment,source_version:sourceVersion,source_hash:text(input.source_hash)\n}}];"
      }
