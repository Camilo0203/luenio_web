# Copy this file to .env on the production server and replace every value marked CHANGE_ME.
# This template is for the v1 lead-gen launch: public SaaS billing stays disabled.

NODE_ENV=production
SERVE_DIST=true
# Temporary catalog/showcase mode only. Keep false when the private CRM is enabled.
PUBLIC_DEMO_MODE=false
HOST=0.0.0.0
PORT=4180

# Docker Compose isolation. For staging use staging aliases/network and a separate env file.
LUENIO_ENV_FILE=/etc/luenio/production.env
LUENIO_IMAGE=luenio-app:CHANGE_ME_RELEASE
APP_HOST=luenio.com
APP_EDGE_ALIAS=app-production
N8N_EDGE_ALIAS=n8n-production
EDGE_NETWORK=luenio-production-edge

APP_URL=https://luenio.com
ALLOWED_HOSTS=luenio.com,www.luenio.com
COOKIE_SECURE=true
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
REQUIRE_TRUSTED_PROXY=true
TRUSTED_PROXY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
HEALTHCHECK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SESSION_TTL_SECONDS=86400
PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILURES=5
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
ADMIN_MFA_REQUIRED=true
AUTH_MFA_WEBHOOK_URL=https://automation.luenio.com/webhook/luenio-admin-mfa
AUTH_MFA_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

SUPABASE_URL=https://CHANGE_ME_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
REQUIRE_SUPABASE=true

CONTACT_WEBHOOK_URL=https://CHANGE_ME_CONTACT_WEBHOOK
CONTACT_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CONTACT_DELIVERY_WORKER_ENABLED=true
CONTACT_DELIVERY_WORKER_INTERVAL_MS=30000
CONTACT_DELIVERY_WORKER_BATCH_SIZE=10
LUENIO_WEBHOOK_URL=
LUENIO_CRM_WEBHOOK_URL=
LUENIO_WHATSAPP_WEBHOOK_URL=
LUENIO_EMAIL_WEBHOOK_URL=
AUTOMATION_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY
TURNSTILE_REQUIRED=true
TURNSTILE_ALLOWED_HOSTNAMES=luenio.com
GA_MEASUREMENT_ID=CHANGE_ME_GA4_MEASUREMENT_ID
LEGAL_IDENTITY_READY=false
ADMIN_EMAILS=contacto@luenio.com
INVITATION_WEBHOOK_URL=https://automation.luenio.com/webhook/luenio-invitation
INVITATION_WEBHOOK_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

N8N_VERSION=2.25.7
N8N_HOST=automation.luenio.com
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

SENTRY_DSN_SERVER=CHANGE_ME_SENTRY_SERVER_DSN
SENTRY_DSN_PUBLIC=CHANGE_ME_SENTRY_BROWSER_DSN
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=luenio@CHANGE_ME_RELEASE
SENTRY_TRACES_SAMPLE_RATE=0.15

ENABLE_PUBLIC_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

RATE_LIMIT_MAX=120
SENSITIVE_RATE_LIMIT_MAX=30
MAX_BODY_BYTES=64000
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=100
MAX_CONNECTIONS=512
