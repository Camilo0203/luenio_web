# --- Runtime mode ---
# development | production. Leave as "development" for local work; the
# Docker image bakes NODE_ENV=production into the container itself, so you
# normally do not need to set this in a real deployment .env at all.
#
# Production fail-closed (see server.js assertSecureProductionRuntime) also
# requires: HTTPS APP_URL, ALLOWED_HOSTS, AUTH_SECRET (>=32), trusted proxy
# secret, HEALTHCHECK_TOKEN, REQUIRE_SUPABASE, Turnstile, CONTACT_* webhooks
# + delivery worker, INVITATION_WEBHOOK_*, ADMIN MFA webhooks, unique secrets.
NODE_ENV=development
# Public-only launch: hides and blocks login, invitations, resets, CRM and their APIs.
# Change to false only when the complete private client portal is ready to return.
PUBLIC_DEMO_MODE=true

# --- Database (Supabase) — auth + leads operativos existentes ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to true in production so the server fails closed instead of silently
# falling back to the local db/leads-db.json file when Supabase is misconfigured.
REQUIRE_SUPABASE=false

# --- Agency CRM premium (laboratorio congelado; apagado por defecto) ---
ENABLE_AGENCY_CRM=false
# Solo configura Neon cuando ENABLE_AGENCY_CRM=true.
# --- Neon Postgres — clients/pipeline/projects/invoices/metrics ---
# 1) npm run db:neon:auth   (completa OAuth en el navegador)
# 2) npm run db:neon:create
# 3) npx neonctl connection-string --project-id <id>
# 4) pega la URL aquí y corre: npm run db:migrate && npm run db:seed
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alias opcional:
# NEON_DATABASE_URL=

# --- Sentry (errors + tracing) ---
# Create a project at https://sentry.io — use the browser-safe DSN for both if needed.
SENTRY_DSN=
SENTRY_DSN_PUBLIC=
SENTRY_ENVIRONMENT=development
# CRM_PUBLIC=false  # solo tiene efecto cuando ENABLE_AGENCY_CRM=true

# --- Automation webhooks ---
LUENIO_WEBHOOK_URL=https://your-n8n-instance/webhook/luenio-leads
LUENIO_CRM_WEBHOOK_URL=https://your-crm-instance/webhook/leads
LUENIO_WHATSAPP_WEBHOOK_URL=https://your-whatsapp-provider/webhook
LUENIO_EMAIL_WEBHOOK_URL=https://your-email-provider/webhook
AUTOMATION_WEBHOOK_TOKEN=replace-with-a-long-random-bearer-token
CONTACT_WEBHOOK_URL=https://your-zapier-make-or-n8n-webhook/contact
CONTACT_WEBHOOK_TOKEN=replace-with-a-long-random-bearer-token
CONTACT_DELIVERY_WORKER_ENABLED=false
CONTACT_DELIVERY_WORKER_INTERVAL_MS=30000
CONTACT_DELIVERY_WORKER_BATCH_SIZE=10

# --- Public form protection ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_REQUIRED=false
TURNSTILE_ALLOWED_HOSTNAMES=luenio.com,staging.luenio.com

# --- Consent-based analytics ---
# Create a GA4 property, then paste G-XXXXXXXX. Loads only after cookie consent.
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Daily CRM digest (optional, P1) ---
# Keep disabled until n8n daily-digest-email workflow + SMTP are ready.
# When true, the app worker POSTs digests (due / stale hot) to the webhook.
DIGEST_CRON_ENABLED=false
DIGEST_WEBHOOK_URL=
DIGEST_WEBHOOK_TOKEN=replace-with-a-long-random-bearer-token
DIGEST_WORKER_INTERVAL_MS=3600000
DIGEST_MIN_HOURS_BETWEEN=20
DIGEST_ONLY_IF_ACTIONABLE=true
# Optional hint for n8n email "to" field
DIGEST_RECIPIENT=

# Keep false until the responsible person/company and formal notice channel
# have been reviewed and published on every legal page.
LEGAL_IDENTITY_READY=false

# --- Private client access ---
ADMIN_EMAILS=contacto@luenio.com
INVITATION_WEBHOOK_URL=
INVITATION_WEBHOOK_TOKEN=replace-with-a-long-random-bearer-token

# --- n8n (Docker deployment) ---
N8N_VERSION=2.25.7
N8N_HOST=automation.luenio.com
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# --- Auth / sessions ---
AUTH_SECRET=replace-with-a-long-random-secret
REQUIRE_TRUSTED_PROXY=false
TRUSTED_PROXY_SECRET=
HEALTHCHECK_TOKEN=luenio-local-healthcheck-token-change-me
SESSION_TTL_SECONDS=86400
PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILURES=5
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
ADMIN_MFA_REQUIRED=false
AUTH_MFA_WEBHOOK_URL=
AUTH_MFA_WEBHOOK_TOKEN=

# --- Cookies & app URL ---
# NOTE: in production the server ALWAYS forces Secure session cookies
# regardless of COOKIE_SECURE (see config/env.js -> isProduction()). This
# flag only matters for local development over plain HTTP.
#
# Local dev default (plain http) -- keep these two lines as-is:
COOKIE_SECURE=false
APP_URL=http://127.0.0.1:4180
ALLOWED_HOSTS=127.0.0.1,localhost
#
# Production values (use these instead in a real server's .env):
# COOKIE_SECURE=true
# APP_URL=https://luenio.com

# --- Stripe billing ---
# Keep public billing disabled for the v1 lead-gen launch. Set to true only
# when /login, checkout, Stripe webhooks and live price IDs are ready to sell
# self-serve subscriptions publicly.
ENABLE_PUBLIC_BILLING=false
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_AGENCY_PRICE_ID=price_agency

# --- Rate limiting & request limits ---
RATE_LIMIT_MAX=120
SENSITIVE_RATE_LIMIT_MAX=30
MAX_BODY_BYTES=64000
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=100
MAX_CONNECTIONS=512

# --- Static asset serving ---
SERVE_DIST=false

# --- Network binding ---
# 127.0.0.1 for local development; the Docker image sets this to 0.0.0.0
# automatically so the server accepts traffic from outside the container.
HOST=127.0.0.1
PORT=4180
